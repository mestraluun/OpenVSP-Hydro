<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cell Viewer: Excel-DNA add-in (.xll) for Excel desktop on Windows.
    Build on Windows:  dotnet build -c Release
    Output:            bin/Release/net462/publish/CellViewer-AddIn64-packed.xll (64-bit Excel)
                       bin/Release/net462/publish/CellViewer-AddIn-packed.xll   (32-bit Excel)
  -->
  <PropertyGroup>
    <!-- 4.6.2 is the lowest .NET Framework Excel-DNA 1.9 supports; works on older PCs (e.g. with Office 2013). -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CellViewer</AssemblyName>
    <RootNamespace>CellViewer</RootNamespace>
    <Version>1.0.1</Version>
    <ExcelAddInName>Cell Viewer</ExcelAddInName>
    <!-- Packing (single-file .xll) runs on Windows; set RunExcelDnaPack=false to compile-check elsewhere. -->
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
